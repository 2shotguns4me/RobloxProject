{
  "name": "RobloxProject",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },

      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,

        "Characters": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Stages": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "VFX": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Sounds": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
