--!strict
local Settings = require("../../src/client/Settings/Settings")

return function(t)
	t.test("defaults", function()
		local s = Settings.new()
		t.eq(s.Get("screenShake"), 0.7)
		t.eq(s.Get("flashIntensity"), 1)
		t.eq(s.Get("reduceFlashing"), false)
		t.eq(s.Get("rumble"), true)
		t.eq(s.Get("slowMo"), true)
		t.eq(s.Get("tapJump"), false)
		t.eq(s.Get("shieldMode"), "hold")
	end)

	t.test("Set validates and clamps", function()
		local s = Settings.new()
		s.Set("screenShake", 2)
		t.eq(s.Get("screenShake"), 1)
		s.Set("flashIntensity", -1)
		t.eq(s.Get("flashIntensity"), 0)
		s.Set("shieldMode", "toggle")
		t.eq(s.Get("shieldMode"), "toggle")
		t.throws(function()
			s.Set("shieldMode", "tap")
		end, "bad enum")
		t.throws(function()
			s.Set("rumble", 1)
		end, "wrong type")
		t.throws(function()
			s.Set("nope", true)
		end, "unknown key")
		t.throws(function()
			s.Get("nope")
		end)
	end)

	t.test("Changed fires once per real change", function()
		local s = Settings.new()
		local seen = {}
		local conn = s.Changed:Connect(function(key, value, old)
			table.insert(seen, { key, value, old })
		end)
		s.Set("rumble", false)
		s.Set("rumble", false)
		t.eq(#seen, 1)
		t.eq(seen[1][1], "rumble")
		t.eq(seen[1][2], false)
		t.eq(seen[1][3], true)
		conn:Disconnect()
		s.Set("rumble", true)
		t.eq(#seen, 1, "disconnected")
	end)

	t.test("Competitive preset: low shake, no slow-mo, inputs untouched", function()
		local s = Settings.new()
		s.Set("tapJump", true)
		s.ApplyPreset("Competitive")
		t.truthy(s.Get("screenShake") <= 0.3)
		t.eq(s.Get("slowMo"), false)
		t.eq(s.Get("reduceFlashing"), true)
		t.eq(s.Get("tapJump"), true)
		s.ApplyPreset("Default")
		t.eq(s.Get("screenShake"), 0.7)
		t.eq(s.Get("slowMo"), true)
		t.throws(function()
			s.ApplyPreset("Ultra")
		end)
	end)

	t.test("Observe fires immediately and on change", function()
		local s = Settings.new()
		local values = {}
		s.Observe("screenShake", function(v)
			table.insert(values, v)
		end)
		s.Set("slowMo", false)
		s.Set("screenShake", 0.2)
		t.eq(#values, 2)
		t.eq(values[1], 0.7)
		t.eq(values[2], 0.2)
	end)

	t.test("persistence seam: load merges valid values, save on change", function()
		local s = Settings.new()
		local saved = nil
		s.SetPersistence({
			load = function()
				return { screenShake = 0.4, shieldMode = "bogus", unknown = 1 }
			end,
			save = function(values)
				saved = values
			end,
		})
		t.eq(s.Get("screenShake"), 0.4)
		t.eq(s.Get("shieldMode"), "hold", "invalid loaded values are ignored")
		t.eq(saved, nil, "loading does not save")
		s.Set("rumble", false)
		t.truthy(saved)
		t.eq((saved :: any).rumble, false)
	end)

	t.test("stores are isolated", function()
		local a, b = Settings.new(), Settings.new()
		a.Set("screenShake", 0.1)
		t.eq(b.Get("screenShake"), 0.7)
	end)
end
